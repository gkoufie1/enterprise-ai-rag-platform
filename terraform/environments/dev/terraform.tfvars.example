# Copy to terraform.tfvars (git-ignored) and adjust.
aws_region      = "us-east-1"
alarm_email     = "you@example.com"
allowed_origins = ["http://localhost:3000"]

# Claude model. The default, Claude Haiku 4.5 through the classic Bedrock endpoint, works on most
# accounts. AWS enables the newest models (Opus 5.5) per account; once yours has access:
# claude_endpoint   = "mantle"
# claude_model_id   = "anthropic.claude-opus-5-5"
# fallback_model_id = "anthropic.claude-opus-4-8"
# claude_effort     = "low"

# Dev convenience: let `terraform destroy` remove buckets that still hold data.
force_destroy = true

# Public demo login shown on the sign-in page. Create the account after deploying:
#   RAG_PASSWORD='...' scripts/create_user.sh demo@example.com demo
# demo_login_hint  = "Email: demo@example.com   Password: <the password you chose>"
# demo_daily_limit = 30
